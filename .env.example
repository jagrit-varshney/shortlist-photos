# Absolute path to your photos folder on disk
PHOTOS_ROOT=/path/to/your/photos

# Path for SQLite database file (created automatically)
DATABASE_PATH=./data/shortlist.db

# Path for generated thumbnail cache (created automatically)
THUMBNAILS_PATH=./data/thumbnails

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Base URL of the app (used for server-side fetch)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
